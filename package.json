{
    "name": "sidedrop",
    "private": true,
    "version": "1.0.0",
    "license": "MIT",
    "type": "module",
    "description": "Sidedrop — real-time peer-to-peer, browser-to-browser file transfer. No cloud, no storage, no account.",
    "scripts": {
        "switch_to_dev": "shx cp -f ./env/env.dev .env",
        "switch_to_prod": "shx cp -f ./env/env.prod .env",
        "serve": "vite",
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "re-install-npm": "npm cache clean --force && shx rm -rf node_modules dist package-lock.json && npm install",
        "prepare": "husky || exit 0"
    },
    "dependencies": {
        "fflate": "0.8.3",
        "pinia": "4.0.3",
        "qrcode": "1.5.4",
        "vue": "3.5.43",
        "vue-i18n": "11.4.13",
        "vue-router": "5.3.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/qrcode": "1.5.6",
        "@vitejs/plugin-vue": "6.0.9",
        "@vue/test-utils": "2.5.1",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-vue": "10.11.1",
        "globals": "17.13.0",
        "happy-dom": "20.14.5",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "prettier": "3.9.9",
        "shx": "0.4.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.2",
        "vitest": "5.0.3",
        "vue-eslint-parser": "10.4.1",
        "vue-tsc": "3.3.11"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,mts,cts,vue}": "eslint --fix --no-warn-ignored",
        "*": "prettier --write --ignore-unknown"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
